{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Syronius FRAME Gallery API (V1)",
  "$defs": {
    "date": {
      "type": "object",
      "additionalProperties": false,
      "required": ["date_folder", "count", "first_at", "latest_at", "duration_ms", "cover_thumbnail_url"],
      "properties": {
        "date_folder": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
        "count": { "type": "integer", "minimum": 1 },
        "first_at": { "type": ["string", "null"], "format": "date-time" },
        "latest_at": { "type": ["string", "null"], "format": "date-time" },
        "duration_ms": { "type": "integer", "minimum": 0 },
        "cover_thumbnail_url": { "type": ["string", "null"], "pattern": "^/gallery/thumb/" }
      }
    },
    "photo": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "base",
        "date_folder",
        "image_url",
        "thumbnail_url",
        "width",
        "height",
        "orientation",
        "processed_at",
        "camera_text"
      ],
      "properties": {
        "base": { "type": "string", "pattern": "^[A-Za-z0-9_-]+$" },
        "date_folder": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
        "image_url": { "type": "string", "pattern": "^/gallery/image/" },
        "thumbnail_url": { "type": "string", "pattern": "^/gallery/thumb/" },
        "width": { "type": ["integer", "null"], "minimum": 1 },
        "height": { "type": ["integer", "null"], "minimum": 1 },
        "orientation": { "type": "integer", "enum": [0, 1] },
        "processed_at": { "type": "string", "format": "date-time" },
        "camera_text": { "type": "string" }
      }
    }
  },
  "oneOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["dates"],
      "properties": {
        "dates": { "type": "array", "items": { "$ref": "#/$defs/date" } }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["date_folder", "photos"],
      "properties": {
        "date_folder": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
        "photos": { "type": "array", "items": { "$ref": "#/$defs/photo" } }
      }
    }
  ]
}
