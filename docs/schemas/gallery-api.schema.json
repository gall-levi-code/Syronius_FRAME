{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Syronius FRAME Gallery API (V1)",
  "$defs": {
    "date": {
      "type": "object",
      "additionalProperties": false,
      "required": ["date_folder", "count", "first_at", "latest_at", "duration_ms", "cover_base", "cover_fallback_active", "cover_is_custom", "cover_thumbnail_url", "has_explore"],
      "properties": {
        "date_folder": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
        "count": { "type": "integer", "minimum": 1 },
        "first_at": { "type": ["string", "null"], "format": "date-time" },
        "latest_at": { "type": ["string", "null"], "format": "date-time" },
        "duration_ms": { "type": "integer", "minimum": 0 },
        "cover_base": { "type": ["string", "null"], "pattern": "^[A-Za-z0-9_-]+$" },
        "cover_fallback_active": { "type": "boolean" },
        "cover_is_custom": { "type": "boolean" },
        "cover_thumbnail_url": { "type": ["string", "null"], "pattern": "^/gallery/thumb/" },
        "has_explore": { "type": "boolean" }
      }
    },
    "photo": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "base",
        "date_folder",
        "thumbnail_url",
        "width",
        "height",
        "orientation",
        "processed_at",
        "capture_clock",
        "camera_text"
      ],
      "properties": {
        "base": { "type": "string", "pattern": "^[A-Za-z0-9_-]+$" },
        "date_folder": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
        "thumbnail_url": { "type": "string", "pattern": "^/gallery/thumb/" },
        "width": { "type": ["integer", "null"], "minimum": 1 },
        "height": { "type": ["integer", "null"], "minimum": 1 },
        "orientation": { "type": "integer", "enum": [0, 1] },
        "processed_at": { "type": "string", "format": "date-time" },
        "capture_clock": { "type": ["string", "null"] },
        "camera_text": { "type": "string" }
      }
    },
    "palette": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "background",
        "topbar",
        "text",
        "controlText",
        "accent",
        "secondary",
        "surface",
        "surfaceStrong",
        "border",
        "muted",
        "danger",
        "good",
        "lightboxBackground",
        "lightboxText"
      ],
      "properties": {
        "background": { "type": "string", "pattern": "^#[0-9a-f]{6}$" },
        "topbar": { "type": "string", "pattern": "^#[0-9a-f]{6}$" },
        "text": { "type": "string", "pattern": "^#[0-9a-f]{6}$" },
        "controlText": { "type": "string", "pattern": "^#[0-9a-f]{6}$" },
        "accent": { "type": "string", "pattern": "^#[0-9a-f]{6}$" },
        "secondary": { "type": "string", "pattern": "^#[0-9a-f]{6}$" },
        "surface": { "type": "string", "pattern": "^#[0-9a-f]{6}$" },
        "surfaceStrong": { "type": "string", "pattern": "^#[0-9a-f]{6}$" },
        "border": { "type": "string", "pattern": "^#[0-9a-f]{6}$" },
        "muted": { "type": "string", "pattern": "^#[0-9a-f]{6}$" },
        "danger": { "type": "string", "pattern": "^#[0-9a-f]{6}$" },
        "good": { "type": "string", "pattern": "^#[0-9a-f]{6}$" },
        "lightboxBackground": { "type": "string", "pattern": "^#[0-9a-f]{6}$" },
        "lightboxText": { "type": "string", "pattern": "^#[0-9a-f]{6}$" }
      }
    },
    "profile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "theme_color", "palettes"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
        "name": { "type": "string", "minLength": 1, "maxLength": 40 },
        "theme_color": { "type": "string", "pattern": "^#[0-9a-f]{6}$" },
        "palettes": {
          "type": "object",
          "additionalProperties": false,
          "required": ["day", "night"],
          "properties": {
            "day": { "$ref": "#/$defs/palette" },
            "night": { "$ref": "#/$defs/palette" }
          }
        }
      }
    },
    "logo": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["url", "width", "height", "updated_at"],
      "properties": {
        "url": { "type": "string", "pattern": "^/gallery/branding/logo\\.webp\\?v=" },
        "width": { "type": "integer", "minimum": 1, "maximum": 720 },
        "height": { "type": "integer", "minimum": 1, "maximum": 240 },
        "updated_at": { "type": "string", "format": "date-time" }
      }
    },
    "socialGraphic": {
      "type": "object",
      "additionalProperties": false,
      "required": ["url", "width", "height", "updated_at"],
      "properties": {
        "url": { "type": "string", "pattern": "^/gallery/branding/socials/[A-Za-z0-9_-]{1,64}/graphic\\.webp\\?v=" },
        "width": { "type": "integer", "minimum": 1 },
        "height": { "type": "integer", "minimum": 1 },
        "updated_at": { "type": "string", "format": "date-time" }
      }
    },
    "social": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "platform", "url"],
      "properties": {
        "id": { "type": "string", "pattern": "^[A-Za-z0-9_-]{1,64}$" },
        "platform": {
          "type": "string",
          "enum": ["website", "instagram", "tiktok", "youtube", "twitch", "facebook", "x", "threads", "bluesky", "discord", "linkedin", "reddit", "snapchat", "flickr"]
        },
        "label": { "type": "string", "minLength": 1, "maxLength": 60 },
        "url": { "type": "string", "maxLength": 2048, "pattern": "^https?://" },
        "graphic": { "$ref": "#/$defs/socialGraphic" }
      }
    },
    "branding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "brand_name",
        "gallery_title",
        "show_download_button",
        "mode",
        "profile_id",
        "custom_profiles",
        "socials",
        "logo",
        "updated_at",
        "active_profile",
        "presets"
      ],
      "properties": {
        "brand_name": { "type": "string", "minLength": 1, "maxLength": 60 },
        "gallery_title": { "type": "string", "minLength": 1, "maxLength": 80 },
        "show_download_button": { "type": "boolean", "default": false },
        "mode": { "type": "string", "enum": ["system", "day", "night"] },
        "profile_id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
        "custom_profiles": { "type": "array", "items": { "$ref": "#/$defs/profile" } },
        "socials": { "type": "array", "maxItems": 32, "items": { "$ref": "#/$defs/social" } },
        "logo": { "$ref": "#/$defs/logo" },
        "updated_at": { "type": "string", "format": "date-time" },
        "active_profile": { "$ref": "#/$defs/profile" },
        "presets": { "type": "array", "minItems": 5, "items": { "$ref": "#/$defs/profile" } }
      }
    },
    "tile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["x", "y", "width", "height", "url"],
      "properties": {
        "x": { "type": "integer", "minimum": 0 },
        "y": { "type": "integer", "minimum": 0 },
        "width": { "type": "integer", "minimum": 1, "maximum": 512 },
        "height": { "type": "integer", "minimum": 1, "maximum": 512 },
        "url": { "type": "string", "pattern": "^/gallery/tile/[A-Za-z0-9_-]{43}/(?:0|[1-9][0-9]*)/(?:0|[1-9][0-9]*)\\.webp$" }
      }
    },
    "tileView": {
      "type": "object",
      "additionalProperties": false,
      "required": ["handle", "width", "height", "tile_size", "overlap", "columns", "rows", "tiles"],
      "properties": {
        "handle": { "type": "string", "pattern": "^[A-Za-z0-9_-]{43}$" },
        "width": { "type": "integer", "minimum": 1 },
        "height": { "type": "integer", "minimum": 1 },
        "tile_size": { "type": "integer", "const": 512 },
        "overlap": { "type": "integer", "const": 1 },
        "columns": { "type": "integer", "minimum": 1 },
        "rows": { "type": "integer", "minimum": 1 },
        "tiles": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/tile" } }
      }
    }
  },
  "oneOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["dates"],
      "properties": {
        "dates": { "type": "array", "items": { "$ref": "#/$defs/date" } }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["date_folder", "photos"],
      "properties": {
        "date_folder": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
        "photos": { "type": "array", "items": { "$ref": "#/$defs/photo" } }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["branding"],
      "properties": {
        "branding": { "$ref": "#/$defs/branding" }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["view"],
      "properties": {
        "view": { "$ref": "#/$defs/tileView" }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["date_folder", "explore"],
      "properties": {
        "date_folder": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
        "explore": {
          "oneOf": [
            { "$ref": "gallery-explore.schema.json" },
            { "type": "null" }
          ]
        }
      }
    }
  ]
}
