{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://frame.local/schemas/gallery-explore.schema.json",
  "title": "Syronius FRAME Gallery Explore",
  "$comment": "The API additionally limits the whole document to 2,000 segments, 50,000 points, and a 5 MiB request body.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "updated_at",
    "time_shift_seconds",
    "time_adjustment_seconds",
    "routes",
    "placements"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "updated_at": { "type": "string", "format": "date-time" },
    "time_shift_seconds": { "type": "number", "minimum": -86400, "maximum": 86400 },
    "time_adjustment_seconds": { "type": "number", "minimum": -86400, "maximum": 86400 },
    "routes": {
      "type": "array",
      "minItems": 1,
      "maxItems": 20,
      "items": { "$ref": "#/$defs/route" }
    },
    "placements": {
      "type": "object",
      "maxProperties": 10000,
      "propertyNames": { "pattern": "^[A-Za-z0-9_-]+$" },
      "additionalProperties": { "$ref": "#/$defs/placement" }
    }
  },
  "$defs": {
    "point": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "prefixItems": [
        { "type": "integer", "minimum": 0, "maximum": 8640000000000000 },
        { "type": "number", "minimum": -90, "maximum": 90 },
        { "type": "number", "minimum": -180, "maximum": 180 }
      ],
      "items": false
    },
    "segment": {
      "type": "array",
      "minItems": 2,
      "maxItems": 50000,
      "items": { "$ref": "#/$defs/point" }
    },
    "route": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "imported_at", "segments"],
      "properties": {
        "id": { "type": "string", "pattern": "^[A-Za-z0-9_-]{1,96}$" },
        "name": { "type": "string", "minLength": 1, "maxLength": 240 },
        "imported_at": { "type": "string", "format": "date-time" },
        "segments": {
          "type": "array",
          "minItems": 1,
          "maxItems": 2000,
          "items": { "$ref": "#/$defs/segment" }
        }
      }
    },
    "placement": {
      "type": "object",
      "additionalProperties": false,
      "required": ["lat", "lon", "updated_at"],
      "properties": {
        "lat": { "type": "number", "minimum": -90, "maximum": 90 },
        "lon": { "type": "number", "minimum": -180, "maximum": 180 },
        "timestamp": { "type": "integer", "minimum": -8640000000000000, "maximum": 8640000000000000 },
        "updated_at": { "type": "string", "format": "date-time" }
      }
    }
  }
}
