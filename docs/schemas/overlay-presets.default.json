{
  "schema_version": "1.0",
  "default_preset_id": "default-connectivity",
  "presets": [
    {
      "id": "default-connectivity",
      "name": "Default Connectivity",
      "description": "Stock FRAME connectivity profile. Keeps the most useful live relay fields visible and clearly marks degraded stream quality.",
      "tags": ["connectivity", "stock", "default", "full-stats"],
      "enabled": true,
      "window_title": "FRAME: Default Connectivity",
      "type": "connectivity",
      "layout": {
        "dock": "br",
        "pad": 20,
        "scale": 1.0,
        "width_px": 420,
        "height_px": 0
      },
      "theme": {
        "text_color": "#eef8ff",
        "muted_color": "#9fc6dc",
        "good_color": "#2cb4fb",
        "warn_color": "#ffd166",
        "bad_color": "#ff5f6d",
        "plot_primary": "rgba(44, 180, 251, 0.95)",
        "plot_secondary": "#8de7ff",
        "bg_opacity_good": 0.3,
        "bg_opacity_warn": 0.5,
        "bg_opacity_bad": 0.72,
        "border_radius_px": 8,
        "backdrop_blur_px": 2,
        "font_size_base_px": 16
      },
      "config": {
        "stream_profile_id": null,
        "poll_ms": 1000,
        "bitrate_good_min": 5000,
        "bitrate_warn_min": 2500,
        "rtt_warn_max": 1500,
        "rtt_bad_max": 3500,
        "bitrate_meter_max": 12000,
        "chart_bitrate_max": 12000,
        "chart_rtt_max": 6000,
        "history_len": 10,
        "bitrate_streak_warn": 2,
        "bitrate_streak_bad": 2,
        "rtt_streak_warn": 2,
        "rtt_streak_bad": 2,
        "use_rtt_in_good": true,
        "compact_when_good": false,
        "show_name": true,
        "show_status": true,
        "show_bitrate": true,
        "show_rtt": true,
        "show_latency": false,
        "show_buffer": false,
        "show_chart": true,
        "show_meter": true,
        "show_server": true,
        "show_dropped": true,
        "show_uptime": true,
        "show_recovery": false,
        "telemetry_order": ["header", "bitrate", "rtt", "latency", "buffer", "server", "dropped", "uptime", "meter", "chart", "recovery"],
        "telemetry_block_width_px": 160,
        "telemetry_block_height_px": 72,
        "no_signal_behavior": "show_offline",
        "no_signal_label": "NO SIGNAL",
        "label_style": "svg",
        "transition_ms": 250
      }
    }
  ]
}
