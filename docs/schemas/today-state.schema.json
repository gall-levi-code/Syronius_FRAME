{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Syronius FRAME Today viewer state (V1)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "type",
    "revision",
    "server_time",
    "updated_at",
    "date_folder",
    "current_index",
    "current_base",
    "current_filename",
    "slideshow_running",
    "playback_state",
    "interval_ms",
    "interval_started_at",
    "next_change_at",
    "presentation_mode",
    "presentation_started_at",
    "presentation_duration_ms",
    "count_today",
    "show_exif",
    "show_background",
    "current_photo",
    "photos"
  ],
  "properties": {
    "type": { "const": "STATE" },
    "revision": { "type": "integer", "minimum": 0 },
    "server_time": { "type": "string", "format": "date-time" },
    "updated_at": { "type": ["string", "null"], "format": "date-time" },
    "date_folder": { "type": ["string", "null"], "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "current_index": { "type": "integer", "minimum": -1 },
    "current_base": { "type": ["string", "null"] },
    "current_filename": { "type": ["string", "null"] },
    "slideshow_running": { "type": "boolean" },
    "playback_state": { "type": "string", "enum": ["playing", "paused", "stopped"] },
    "interval_ms": { "type": "integer", "minimum": 1000, "maximum": 300000 },
    "interval_started_at": { "type": ["string", "null"], "format": "date-time" },
    "next_change_at": { "type": ["string", "null"], "format": "date-time" },
    "presentation_mode": { "type": "string", "enum": ["default", "auto-scroll"] },
    "presentation_started_at": { "type": ["string", "null"], "format": "date-time" },
    "presentation_duration_ms": { "type": "integer", "const": 7000 },
    "count_today": { "type": "integer", "minimum": 0 },
    "show_exif": { "type": "boolean" },
    "show_background": { "type": "boolean" },
    "current_photo": { "type": ["object", "null"] },
    "photos": { "type": "array", "items": { "type": "object" } }
  }
}
