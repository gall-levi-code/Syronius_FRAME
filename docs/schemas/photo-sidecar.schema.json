{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Syronius FRAME photo sidecar (V1)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "base",
    "original_name",
    "detected_mime",
    "detected_format",
    "width",
    "height",
    "orientation",
    "processed_at",
    "date_folder",
    "exif",
    "warnings"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "base": { "type": "string", "minLength": 1 },
    "original_name": { "type": "string", "minLength": 1 },
    "detected_mime": { "type": "string", "minLength": 1 },
    "detected_format": { "type": "string", "minLength": 1 },
    "width": { "type": "integer", "minimum": 1 },
    "height": { "type": "integer", "minimum": 1 },
    "orientation": { "type": "integer", "enum": [0, 1] },
    "processed_at": { "type": "string", "format": "date-time" },
    "date_folder": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "exif": { "type": "object" },
    "warnings": {
      "type": "array",
      "items": { "type": "string" }
    }
  }
}
