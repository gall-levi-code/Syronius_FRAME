{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Syronius FRAME trashed publication marker (V1)",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "date_folder", "base", "trashed_at"],
  "properties": {
    "schema_version": { "const": 1 },
    "date_folder": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "base": { "type": "string", "pattern": "^[A-Za-z0-9_-]+$" },
    "trashed_at": { "type": "string", "format": "date-time" }
  }
}
