{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Syronius FRAME /status/api response (V1)",
  "type": "object",
  "additionalProperties": false,
  "required": ["generated_at", "mode", "services", "disk"],
  "properties": {
    "generated_at": {
      "type": "string",
      "format": "date-time",
      "description": "ISO 8601 UTC timestamp when this response was generated."
    },
    "mode": {
      "type": "string",
      "enum": ["LAN", "HYBRID"]
    },
    "services": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "status"],
        "properties": {
          "name": { "type": "string" },
          "status": { "type": "string", "enum": ["running", "stopped", "error", "unknown"] },
          "health": { "type": "string", "enum": ["healthy", "unhealthy", "starting", "unknown"] },
          "uptime_seconds": { "type": ["integer", "null"], "minimum": 0 }
        }
      }
    },
    "last_photo": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["at", "base"],
      "properties": {
        "at": { "type": "string", "format": "date-time" },
        "base": { "type": "string" }
      }
    },
    "last_ingest": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["at", "stream_id"],
      "properties": {
        "at": { "type": "string", "format": "date-time" },
        "stream_id": { "type": "string" }
      }
    },
    "audio_streams": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["stream_id", "status"],
        "properties": {
          "stream_id": { "type": "string" },
          "status": { "type": "string", "enum": ["live", "idle", "offline"] },
          "listener_count": { "type": "integer", "minimum": 0 }
        }
      }
    },
    "discord_audio_bridges": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "guild_id",
          "status",
          "active_mix_count",
          "active_streamers",
          "speaking_users",
          "bot_connected",
          "voice_connection",
          "clients",
          "engine_health"
        ],
        "properties": {
          "guild_id": { "type": "string" },
          "status": { "type": "string", "enum": ["active", "idle", "offline", "error"] },
          "channel_name": { "type": ["string", "null"] },
          "active_mix_count": { "type": "integer", "minimum": 0 },
          "active_streamers": {
            "type": "array",
            "items": { "type": "string" }
          },
          "speaking_users": {
            "type": "array",
            "items": { "type": "string" }
          },
          "bot_connected": { "type": "boolean" },
          "voice_connection": { "type": "string" },
          "clients": {
            "type": "object",
            "additionalProperties": false,
            "required": ["audio", "overlay", "control"],
            "properties": {
              "audio": { "type": "integer", "minimum": 0 },
              "overlay": { "type": "integer", "minimum": 0 },
              "control": { "type": "integer", "minimum": 0 }
            }
          },
          "engine_health": { "type": "string", "enum": ["ok", "warn", "bad", "idle", "unknown"] }
        }
      }
    },
    "disk": {
      "type": "object",
      "additionalProperties": false,
      "required": ["used_bytes", "free_bytes", "total_bytes", "percent_used"],
      "properties": {
        "used_bytes": { "type": "integer", "minimum": 0 },
        "free_bytes": { "type": "integer", "minimum": 0 },
        "total_bytes": { "type": "integer", "minimum": 0 },
        "percent_used": { "type": "number", "minimum": 0, "maximum": 100 }
      }
    },
    "alerts": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["level", "message"],
        "properties": {
          "level": { "type": "string", "enum": ["warn", "error"] },
          "message": { "type": "string" }
        }
      }
    }
  }
}
