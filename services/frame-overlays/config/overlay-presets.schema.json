{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://frame.local/schemas/overlay-presets.schema.json",
  "title": "FRAME Overlay V2 State",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "revision", "default_template_id", "default_template_ids", "templates", "presets", "sources", "legacy_aliases"],
  "properties": {
    "schema_version": { "const": "2.0" },
    "revision": { "type": "integer", "minimum": 0 },
    "default_template_id": { "$ref": "#/$defs/id" },
    "default_template_ids": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "connectivity": { "$ref": "#/$defs/id" },
        "upload_progress": { "$ref": "#/$defs/id" },
        "latest_photo": { "$ref": "#/$defs/id" }
      }
    },
    "templates": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/template" }
    },
    "presets": {
      "type": "array",
      "items": { "$ref": "#/$defs/preset" }
    },
    "sources": {
      "type": "array",
      "items": { "$ref": "#/$defs/source" }
    },
    "legacy_aliases": {
      "type": "object",
      "propertyNames": { "$ref": "#/$defs/id" },
      "additionalProperties": { "$ref": "#/$defs/source_id" }
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]*[a-z0-9]$",
      "minLength": 2,
      "maxLength": 64
    },
    "source_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]*[a-z0-9]$",
      "minLength": 2,
      "maxLength": 80
    },
    "layout": {
      "type": "object",
      "additionalProperties": false,
      "required": ["dock", "pad"],
      "properties": {
        "dock": { "enum": ["tl", "t", "tr", "l", "c", "r", "bl", "b", "br"] },
        "pad": { "type": "number", "minimum": 0, "maximum": 200 },
        "growth_x": { "enum": ["left", "right", "center"] },
        "growth_y": { "enum": ["up", "down", "center"] },
        "scale": { "type": "number", "minimum": 0.5, "maximum": 3 },
        "width_px": { "type": "number", "minimum": 0, "maximum": 1200 },
        "height_px": { "type": "number", "minimum": 0, "maximum": 1000 }
      }
    },
    "theme": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "text_color": { "type": "string", "maxLength": 64 },
        "muted_color": { "type": "string", "maxLength": 64 },
        "good_color": { "type": "string", "maxLength": 64 },
        "warn_color": { "type": "string", "maxLength": 64 },
        "bad_color": { "type": "string", "maxLength": 64 },
        "plot_primary": { "type": "string", "maxLength": 64 },
        "plot_secondary": { "type": "string", "maxLength": 64 },
        "panel_bg_color": { "type": "string", "maxLength": 64 },
        "panel_border_color": { "type": "string", "maxLength": 64 },
        "panel_glow_color": { "type": "string", "maxLength": 64 },
        "block_bg_color": { "type": "string", "maxLength": 64 },
        "block_border_color": { "type": "string", "maxLength": 64 },
        "panel_bg_alpha": { "type": "number", "minimum": 0, "maximum": 1 },
        "block_bg_alpha": { "type": "number", "minimum": 0, "maximum": 1 },
        "bg_opacity_good": { "type": "number", "minimum": 0, "maximum": 1 },
        "bg_opacity_warn": { "type": "number", "minimum": 0, "maximum": 1 },
        "bg_opacity_bad": { "type": "number", "minimum": 0, "maximum": 1 },
        "border_radius_px": { "type": "number", "minimum": 0, "maximum": 50 },
        "backdrop_blur_px": { "type": "number", "minimum": 0, "maximum": 50 },
        "panel_padding_px": { "type": "number", "minimum": 0, "maximum": 60 },
        "block_padding_px": { "type": "number", "minimum": 0, "maximum": 40 },
        "block_gap_px": { "type": "number", "minimum": 0, "maximum": 40 },
        "panel_border_width_px": { "type": "number", "minimum": 0, "maximum": 8 },
        "block_border_width_px": { "type": "number", "minimum": 0, "maximum": 8 },
        "glow_blur_px": { "type": "number", "minimum": 0, "maximum": 80 },
        "glow_spread_px": { "type": "number", "minimum": -20, "maximum": 80 },
        "glow_offset_x_px": { "type": "number", "minimum": -80, "maximum": 80 },
        "glow_offset_y_px": { "type": "number", "minimum": -80, "maximum": 80 },
        "font_size_base_px": { "type": "number", "minimum": 10, "maximum": 32 },
        "font_family": { "type": "string", "maxLength": 120 },
        "font_weight": { "type": "number", "minimum": 100, "maximum": 900 },
        "subheader_font_family": { "type": "string", "maxLength": 120 },
        "subheader_font_size_px": { "type": "number", "minimum": 8, "maximum": 24 },
        "subheader_font_weight": { "type": "number", "minimum": 100, "maximum": 900 }
      }
    },
    "connectivity_config": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "poll_ms": { "type": "integer", "minimum": 200, "maximum": 2000 },
        "bitrate_good_min": { "type": "number", "minimum": 0 },
        "bitrate_warn_min": { "type": "number", "minimum": 0 },
        "rtt_warn_max": { "type": "number", "minimum": 0 },
        "rtt_bad_max": { "type": "number", "minimum": 1 },
        "bitrate_meter_max": { "type": "number", "minimum": 1 },
        "bitrate_meter_height_px": { "type": "number", "minimum": 4, "maximum": 40 },
        "bitrate_meter_radius_px": { "type": "number", "minimum": 0, "maximum": 30 },
        "chart_bitrate_max": { "type": "number", "minimum": 1 },
        "chart_rtt_max": { "type": "number", "minimum": 1 },
        "chart_bitrate_line_width_px": { "type": "number", "minimum": 0.5, "maximum": 12 },
        "chart_rtt_line_width_px": { "type": "number", "minimum": 0.5, "maximum": 12 },
        "chart_warn_line_width_px": { "type": "number", "minimum": 0.5, "maximum": 12 },
        "chart_bitrate_line_style": { "enum": ["solid", "dashed", "dotted"] },
        "chart_rtt_line_style": { "enum": ["solid", "dashed", "dotted"] },
        "chart_warn_line_style": { "enum": ["solid", "dashed", "dotted"] },
        "history_len": { "type": "integer", "minimum": 2, "maximum": 600 },
        "bitrate_streak_warn": { "type": "integer", "minimum": 1, "maximum": 60 },
        "bitrate_streak_bad": { "type": "integer", "minimum": 1, "maximum": 60 },
        "rtt_streak_warn": { "type": "integer", "minimum": 1, "maximum": 60 },
        "rtt_streak_bad": { "type": "integer", "minimum": 1, "maximum": 60 },
        "use_rtt_in_good": { "type": "boolean" },
        "compact_when_good": { "type": "boolean" },
        "show_name": { "type": "boolean" },
        "show_status": { "type": "boolean" },
        "show_bitrate": { "type": "boolean" },
        "show_bitrate_in_good": { "type": "boolean" },
        "show_rtt": { "type": "boolean" },
        "show_latency": { "type": "boolean" },
        "show_buffer": { "type": "boolean" },
        "show_chart": { "type": "boolean" },
        "show_chart_legend": { "type": "boolean" },
        "show_meter": { "type": "boolean" },
        "show_server": { "type": "boolean" },
        "show_dropped": { "type": "boolean" },
        "show_uptime": { "type": "boolean" },
        "show_recovery": { "type": "boolean" },
        "telemetry_order": {
          "type": "array",
          "uniqueItems": true,
          "items": { "enum": ["header", "bitrate", "rtt", "latency", "buffer", "server", "dropped", "uptime", "meter", "chart", "recovery"] }
        },
        "telemetry_columns": {
          "oneOf": [
            { "enum": ["auto", "all"] },
            { "type": "integer", "minimum": 1, "maximum": 8 }
          ]
        },
        "telemetry_block_width_px": { "type": "number", "minimum": 80, "maximum": 600 },
        "telemetry_block_height_px": { "type": "number", "minimum": 40, "maximum": 400 },
        "no_signal_behavior": { "enum": ["show_offline", "hide"] },
        "no_signal_label": { "type": "string", "maxLength": 40 },
        "label_style": { "enum": ["svg", "text"] },
        "transition_ms": { "type": "number", "minimum": 0, "maximum": 2000 }
      }
    },
    "upload_progress_config": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "active_poll_ms": { "type": "integer", "minimum": 200 },
        "idle_poll_ms": { "type": "integer", "minimum": 200 },
        "complete_poll_ms": { "type": "integer", "minimum": 200 },
        "complete_hide_ms": { "type": "integer", "minimum": 0 },
        "fetch_timeout_ms": { "type": "integer", "minimum": 200 },
        "show_speed": { "type": "boolean" },
        "show_elapsed": { "type": "boolean" },
        "show_sent": { "type": "boolean" },
        "width_px": { "type": "number", "minimum": 0, "maximum": 1200 },
        "idle_behavior": { "enum": ["show_idle", "hide"] },
        "idle_label": { "type": "string", "maxLength": 80 }
      }
    },
    "latest_photo_config": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "poll_ms": { "type": "integer", "minimum": 200 },
        "show_count": { "type": "boolean" },
        "show_filename": { "type": "boolean" },
        "show_thumbnail": { "type": "boolean" },
        "thumbnail_size_px": { "type": "number", "minimum": 16, "maximum": 1000 },
        "no_photos_behavior": { "enum": ["show_empty", "hide"] },
        "no_photos_label": { "type": "string", "maxLength": 80 }
      }
    },
    "design": {
      "type": "object",
      "required": ["name", "enabled", "type", "layout", "config"],
      "properties": {
        "name": { "type": "string", "minLength": 1, "maxLength": 80 },
        "description": { "type": "string", "maxLength": 280 },
        "tags": {
          "type": "array",
          "uniqueItems": true,
          "maxItems": 10,
          "items": { "type": "string", "maxLength": 32 }
        },
        "enabled": { "type": "boolean" },
        "window_title": { "type": "string", "maxLength": 100 },
        "type": { "enum": ["connectivity", "upload_progress", "latest_photo"] },
        "layout": { "$ref": "#/$defs/layout" },
        "theme": { "$ref": "#/$defs/theme" },
        "config": { "type": "object" }
      },
      "allOf": [
        {
          "if": { "properties": { "type": { "const": "connectivity" } } },
          "then": { "properties": { "config": { "$ref": "#/$defs/connectivity_config" } } }
        },
        {
          "if": { "properties": { "type": { "const": "upload_progress" } } },
          "then": { "properties": { "config": { "$ref": "#/$defs/upload_progress_config" } } }
        },
        {
          "if": { "properties": { "type": { "const": "latest_photo" } } },
          "then": { "properties": { "config": { "$ref": "#/$defs/latest_photo_config" } } }
        }
      ]
    },
    "template": {
      "allOf": [
        { "$ref": "#/$defs/design" },
        {
          "type": "object",
          "required": ["id", "builtin", "readonly"],
          "properties": {
            "id": { "$ref": "#/$defs/id" },
            "builtin": { "const": true },
            "readonly": { "const": true }
          }
        }
      ],
      "unevaluatedProperties": false
    },
    "preset": {
      "allOf": [
        { "$ref": "#/$defs/design" },
        {
          "type": "object",
          "required": ["id", "template_id", "revision", "created_at", "updated_at"],
          "properties": {
            "id": { "$ref": "#/$defs/id" },
            "template_id": { "$ref": "#/$defs/id" },
            "revision": { "type": "integer", "minimum": 1 },
            "created_at": { "type": "string", "format": "date-time" },
            "updated_at": { "type": "string", "format": "date-time" }
          }
        }
      ],
      "unevaluatedProperties": false
    },
    "data_source": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "stream_profile_id"],
          "properties": {
            "kind": { "const": "stream" },
            "stream_profile_id": { "type": ["string", "null"], "pattern": "^[A-Za-z0-9_-]{1,128}$" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "adapters"],
          "properties": {
            "kind": { "const": "upload_progress" },
            "adapters": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": { "enum": ["web_upload", "ftp", "belabox_agent"] }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind"],
          "properties": { "kind": { "const": "latest_photo" } }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind"],
          "properties": { "kind": { "const": "none" } }
        }
      ]
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "slug", "source_key", "display_name", "preset_id", "enabled", "data_source", "revision", "created_at", "updated_at"],
      "properties": {
        "id": { "$ref": "#/$defs/source_id" },
        "slug": { "$ref": "#/$defs/id" },
        "source_key": { "type": "string", "pattern": "^[A-Za-z0-9_-]{20,64}$" },
        "display_name": { "type": "string", "minLength": 1, "maxLength": 80 },
        "preset_id": { "$ref": "#/$defs/id" },
        "enabled": { "type": "boolean" },
        "data_source": { "$ref": "#/$defs/data_source" },
        "revision": { "type": "integer", "minimum": 1 },
        "created_at": { "type": "string", "format": "date-time" },
        "updated_at": { "type": "string", "format": "date-time" }
      }
    }
  }
}
