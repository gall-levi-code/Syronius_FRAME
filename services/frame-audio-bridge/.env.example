DISCORD_TOKEN=your_bot_token_here
DISCORD_CLIENT_ID=your_discord_application_client_id_here
PUBLIC_BASE_URL=http://localhost:3728
PORT=3728
SESSION_SECRET=replace_with_a_long_random_value
DEFAULT_AUDIO_DELAY_MS=2000
MAX_AUDIO_DELAY_MS=10000
SESSION_IDLE_TIMEOUT_MINUTES=30
DATA_DIR=./data

# Optional: require this query token for OBS audio/overlay browser sources.
# When set, /frame-admin setup includes it in the permanent OBS URLs as ?obsToken=...
# READONLY_OBS_TOKEN=replace_with_random_readonly_token

# Optional: enable the private FRAME Portal telemetry endpoint.
# PORTAL_SERVICE_TOKEN=replace_with_a_long_random_service_token
